; -*- mode: emacs-lisp; lexical-binding: t; no-byte-compile: t -*-

(eldev-use-package-archive 'gnu)
(eldev-use-package-archive 'melpa)

(eldev-add-extra-dependencies 'test 'buttercup)

(eldev-use-plugin 'autoloads)

;; package-lint reports `eldoc-highlight-function-argument' as removed in
;; Emacs 25.1.  What went away then was a *function* of that name; the face
;; we theme is defined in eldoc.el to this day and is what eglot and
;; elisp-mode highlight the current argument with.  package-lint matches the
;; symbol against its function database and can't tell the two apart, it has
;; no per-symbol suppression, and this is the only thing it reports for this
;; project, so checkdoc and relint do the linting.
(setf eldev-lint-default '(doc re))
