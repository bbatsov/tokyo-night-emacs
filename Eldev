; -*- mode: emacs-lisp; lexical-binding: t; no-byte-compile: t -*-

(eldev-use-package-archive 'gnu)
(eldev-use-package-archive 'melpa)

(eldev-add-extra-dependencies 'test 'buttercup)

(eldev-use-plugin 'autoloads)

;; package-lint reports `eldoc-highlight-function-argument' as removed in
;; Emacs 25.1.  What went away then was a *function* of that name; the face
;; we theme is defined in eldoc.el to this day and is what eglot and
;; elisp-mode highlight the current argument with.  package-lint matches the
;; symbol against its function database and can't tell the two apart, it has
;; no per-symbol suppression, and this is the only thing it reports for this
;; project, so checkdoc and relint do the linting.
(setf eldev-lint-default '(doc re))

;; The built-in faces are audited by the test suite.  Doing the same for
;; third-party packages means installing them, so that part is a command to
;; run by hand rather than something for CI.
(eldev-defcommand tokyo-night-audit-faces (&rest parameters)
  "Report the faces of popular third-party packages that hardcode a
color the theme doesn't override.  With no PACKAGEs, audit the list in
`tokyo-night-face-audit-packages'."
  :command        audit-faces
  :parameters     "[PACKAGE...]"
  (eldev-call-process eldev-emacs-executable
      `("--batch" "-Q" "-L" "." "-l" "test/tokyo-night-face-audit.el"
        "--eval" ,(format "(progn (add-to-list 'custom-theme-load-path default-directory) (tokyo-night-face-audit-report 'tokyo-night '%S))"
                          (mapcar #'intern parameters)))
    :forward-output t
    :die-on-error   t))
